{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/reacherwu/civil-mcp/schema/design-package/v1/alignments.schema.json",
 "title": "Horizontal alignments",
 "type": "object",
 "properties": {
  "schema": {
   "const": "civil-mcp/design-package/alignments"
  },
  "schema_version": {
   "const": "1.0.0"
  },
  "units": {
   "const": "SI",
   "description": "lengths m, elevations m, areas m², volumes m³, flows m³/s, slopes m/m, angles degrees"
  },
  "alignments": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "sta_start": {
      "type": "number"
     },
     "length": {
      "type": "number",
      "minimum": 0
     },
     "pis": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      "minItems": 2
     },
     "station_equations": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "sta_back": {
         "type": "number"
        },
        "sta_ahead": {
         "type": "number"
        }
       },
       "required": [
        "sta_back",
        "sta_ahead"
       ],
       "additionalProperties": false
      },
      "minItems": 0
     },
     "elements": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/element"
      },
      "minItems": 1
     }
    },
    "required": [
     "name",
     "sta_start",
     "length",
     "pis",
     "station_equations",
     "elements"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  }
 },
 "required": [
  "schema",
  "schema_version",
  "units",
  "alignments"
 ],
 "additionalProperties": false,
 "$defs": {
  "element": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "line",
      "arc",
      "spiral"
     ]
    },
    "sta_start": {
     "type": "number"
    },
    "length": {
     "type": "number",
     "minimum": 0
    },
    "start": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "end": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "direction_start_deg": {
     "type": "number",
     "description": "grid azimuth, degrees clockwise from north"
    },
    "direction_end_deg": {
     "type": "number"
    },
    "radius_start": {
     "type": [
      "number",
      "null"
     ]
    },
    "radius_end": {
     "type": [
      "number",
      "null"
     ]
    },
    "turn": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "left",
      "right",
      null
     ]
    },
    "center": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     }
    },
    "spiral_type": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "clothoid",
      null
     ]
    }
   },
   "required": [
    "type",
    "sta_start",
    "length",
    "start",
    "end",
    "direction_start_deg",
    "direction_end_deg",
    "radius_start",
    "radius_end",
    "turn",
    "center",
    "spiral_type"
   ],
   "additionalProperties": false,
   "description": "radius null = infinite (tangent end of a spiral, or a line)"
  }
 }
}
